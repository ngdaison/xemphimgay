# App
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api/v1
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/webtruyenphim?schema=public
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=webtruyenphim

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=your_access_secret_change_me
JWT_REFRESH_SECRET=your_refresh_secret_change_me
COOKIE_SECRET=your_cookie_secret_change_me
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3

# Media
MEDIA_ROOT_PATH=./media
MEDIA_ORIGIN_URL=http://localhost/media
MEDIA_EDGE_URL=http://localhost/media
UPLOAD_MAX_SIZE=104857600 # 100MB
VIDEO_UPLOAD_MAX_SIZE=2147483648 # 2GB
HLS_SEGMENT_DURATION=4

# Rate Limit
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
